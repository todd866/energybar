# Copy to ~/.config/energybar/.env and keep it mode 600.

# Fronius inverter. Set the full API URL, or just the local IP.
# Example: FRONIUS_LOCAL_IP=192.168.1.50
FRONIUS_LOCAL_IP=
# Example: FRONIUS_SOLAR_API=http://192.168.1.50/solar_api
FRONIUS_SOLAR_API=

# Evnex identifiers. The organisation ID is optional and normally discovered.
EVNEX_CHARGE_POINT_ID=
EVNEX_ORG_ID=

# Optional menu-bar day-total text. Default false keeps the item icon-only.
ENERGYBAR_BAR_TEXT=false

# Optional electricity tariff. Default: ~/.config/energybar/tariff.json.
# No rates are assumed when absent; see README for the schedule format.
# ENERGYBAR_TARIFF_PATH=

# Inverter AC capacity in kW; the Solar bar is full at this. Example: INVERTER_KW=5
INVERTER_KW=

# Optional: a local helper that reads the car's level from its maker's cloud writes this JSON
# ({"soc", "at", "checkedAt", "rangeKm", "source", "error"}). Default shown.
# VEHICLE_CLOUD_CACHE=~/.cache/energybar/vehicle-cloud.json

# Usable vehicle-pack capacity, not nameplate capacity, for estimated SoC.
# Example: EV_BATTERY_KWH=60
EV_BATTERY_KWH=
# Optional AC-to-pack efficiency; defaults to 0.90.
EV_CHARGE_EFFICIENCY=0.90

# Reserved for the future OBD sidecar. The app does not invent data when absent.
# OBD_CACHE_PATH=~/.cache/energybar/obd.json
# OBD_MAX_AGE_SECONDS=900

# Bootstrap ~/.cache/evnex/tokens.json separately with the login command in the
# README. Do not put the Evnex account password in this file.
